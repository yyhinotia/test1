[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://tests/scenario_entry.gd" id="1_scenario_entry"]
[ext_resource type="Resource" path="res://game/world/data/encounters/build_test_1v1.tres" id="2_encounter"]

[node name="ScenarioBuildReplay" type="Node2D"]
script = ExtResource("1_scenario_entry")
scenario_id = &"build_replay"
scenario_title = "Build Replay 实验（首通 → 自主重构 → 再战）"
scenario_instructions = "实验剧本：① 用 Build A 打完这场 1v1，记住最麻烦的地方；② 首通只有定身术这一个奖励；③ 自己决定要不要换 Build（系统不会替你换）；④ 用当前 Build 重打同一个 1v1。记录见 docs/build-gameplay-validation.md §8。"
encounter = ExtResource("2_encounter")
record_combat_events = true
